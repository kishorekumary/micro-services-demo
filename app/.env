# ---------------------------------
# Environment Variables
# ---------------------------------

# 🧠 Environment identifier
APP_ENV=local          # can be: local | docker | prod

# 🌐 RabbitMQ configuration
RABBIT_HOST=rabbitmq.docker
RABBIT_PORT=5672
RABBIT_USER=guest
RABBIT_PASSWORD=guest
RABBIT_QUEUE=order_queue

# 🧾 PostgreSQL configuration
POSTGRES_HOST=postgres.docker
POSTGRES_PORT=5432
POSTGRES_DB=orders_db
POSTGRES_USER=user
POSTGRES_PASSWORD=password

# ⚡ Redis configuration
REDIS_HOST=redis.docker
REDIS_PORT=6379
REDIS_DB=0
REDIS_TTL=300

# 🖥 FastAPI
APP_PORT=8000
# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=orders-bucket
MINIO_ENDPOINT=http://localhost:9000     # inside Docker
MINIO_ENDPOINT_LOCAL=http://localhost:9000  # for local testing